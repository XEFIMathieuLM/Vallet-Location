{
    "name": "functional/billing",
    "description": "",
    "type": "layer",
    "version": "1.0.0",
    "require": {
        "xefi/laravel-osdd": "*",
        "functional/inspection": "*",
        "functional/booking": "*",
        "functional/fleet": "*"
    },
    "autoload": {
        "psr-4": {
            "Functional\\Billing\\": "src/",
            "Functional\\Billing\\Database\\Seeders\\": "database/seeders/",
            "Functional\\Billing\\Database\\Factories\\": "database/factories/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Functional\\Billing\\Providers\\BillingServiceProvider"
            ]
        },
        "faker": {
            "providers": [
                "Functional\\Billing\\Faker\\BillingFakerServiceProvider"
            ]
        }
    }
}
